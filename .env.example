# Paths are JSON arrays. Defaults to the current directory, explicitly local execution only.
VOXOPS_ALLOWED_ROOTS=["/absolute/path/to/workspace"]
VOXOPS_DATA_DIR=.voxops
VOXOPS_MAX_DEPTH=8
VOXOPS_MAX_FILES=3000
VOXOPS_MAX_FILE_BYTES=131072
VOXOPS_MODEL=nvidia:mistralai/mistral-large-4-1t-a52b
VOXOPS_MODEL_TIMEOUT=60
# Optional; missing credentials keep analysis deterministic.
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Reserved until the account-specific Gnani contract is verified; setting it alone enables nothing.
GNANI_API_KEY=

# Stage 2 stores generated files outside the target repository.
# Use an absolute VOXOPS_DATA_DIR outside the source when testing Stage 2.
VOXOPS_ARTIFACT_CONCURRENCY=1
VOXOPS_ARTIFACT_MAX_REQUESTS=60
VOXOPS_ARTIFACT_MAX_TOKENS=150000
VOXOPS_ARTIFACT_TASK_TOKENS=20000
VOXOPS_ARTIFACT_OPTIONAL_TOOLS=false
# User-managed runtime MCP and separate trusted Git HTTPS authentication.
VOXOPS_GITHUB_MCP_URL=
VOXOPS_GITHUB_MCP_TOKEN=
VOXOPS_GIT_CREDENTIAL_HELPER=
